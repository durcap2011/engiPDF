        "weight": "normal",
        "size": 10,
        "color": [0, 0, 0],
        "align": "right"
      }
    },
    {
      "id": "row3-desc",
      "type": "text",
      "x": 22,
      "y": 162,
      "width": 90,
      "height": 6,
