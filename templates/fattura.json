      "style": {
        "font": "helvetica",
        "weight": "normal",
        "size": 10,
        "color": [0, 0, 0],
        "align": "left"
      }
    },
    {
      "id": "row3-qta",
      "type": "text",
      "x": 115,
      "y": 162,
      "width": 30,
      "height": 6,
