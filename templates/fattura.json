{
  "version": 1,
  "name": "Fattura Template",
  "page": {
    "width": 210,
    "height": 297,
    "unit": "mm",
    "margins": { "top": 20, "right": 20, "bottom": 20, "left": 20 }
  },
  "defaultFont": "helvetica",
  "elements": [
    {
      "id": "header-line",
      "type": "rectangle",
      "x": 20,
      "y": 20,
      "width": 170,
      "height": 0.5,
      "fill": [0, 0, 0]
    },
    {
      "id": "azienda",
      "type": "text",
      "x": 20,
      "y": 25,
      "width": 85,
      "height": 8,
      "text": "{{ azienda.nome }}",
      "style": {
        "font": "helvetica",
        "weight": "bold",
        "size": 14,
        "color": [0, 0, 0],
        "align": "left"
      }
    },
    {
      "id": "azienda-indirizzo",
      "type": "text",
      "x": 20,
      "y": 33,
      "width": 85,
      "height": 6,
      "text": "{{ azienda.indirizzo }}",
      "style": {
        "font": "helvetica",
        "weight": "normal",
        "size": 10,
        "color": [0.4, 0.4, 0.4],
        "align": "left"
      }
    },
    {
      "id": "titolo",
      "type": "text",
      "x": 20,
      "y": 50,
      "width": 170,
      "height": 12,
      "text": "FATTURA N. {{ fattura.numero }}",
      "style": {
        "font": "helvetica",
        "weight": "bold",
        "size": 22,
        "color": [0, 0, 0],
        "align": "center"
      }
    },
    {
      "id": "data",
      "type": "text",
      "x": 20,
      "y": 65,
      "width": 170,
      "height": 6,
      "text": "Data: {{ fattura.data }}",
      "style": {
        "font": "helvetica",
        "weight": "normal",
        "size": 10,
        "color": [0.3, 0.3, 0.3],
        "align": "center"
      }
    },
    {
      "id": "separator-1",
      "type": "line",
      "x": 20,
      "y": 78,
      "width": 170,
      "height": 0,
      "color": [0.8, 0.8, 0.8],
      "lineWidth": 0.3
    },
    {
      "id": "cliente-label",
      "type": "text",
      "x": 20,
      "y": 85,
      "width": 40,
      "height": 6,
      "text": "Cliente:",
      "style": {
        "font": "helvetica",
        "weight": "bold",
        "size": 11,
        "color": [0, 0, 0],
        "align": "left"
      }
    },
    {
      "id": "cliente-nome",
      "type": "text",
      "x": 60,
      "y": 85,
      "width": 130,
      "height": 6,
      "text": "{{ cliente.nome }} {{ cliente.cognome }}",
      "style": {
        "font": "helvetica",
        "weight": "normal",
        "size": 11,
        "color": [0, 0, 0],
        "align": "left"
      }
    },
    {
      "id": "cliente-indirizzo",
      "type": "text",
      "x": 60,
      "y": 92,
      "width": 130,
      "height": 6,
      "text": "{{ cliente.indirizzo }}",
      "style": {
        "font": "helvetica",
        "weight": "normal",
        "size": 10,
        "color": [0.3, 0.3, 0.3],
        "align": "left"
      }
    },
    {
      "id": "separator-2",
