{
    "name": "durcap2011/engipdf",
    "description": "Editor web + Generatore PDF puro PHP da template JSON",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "template", "editor", "generator", "php"],
    "homepage": "https://github.com/durcap2011/engiPDF",
    "authors": [
        {
            "name": "durcap2011",
            "email": "durcap2011@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-zlib": "*",
        "ext-mbstring": "*",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EngiPDF\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EngiPDF\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
